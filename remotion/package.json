    "render:messines": "remotion render Messines ../produccion/08_messines/messines_short.mp4",
    "portada:mers": "remotion still MersPortada ../produccion/07_mers_el_kebir/portada_mers_el_kebir.png",
    "portada:nazaire": "remotion still NazairePortada ../produccion/09_saint_nazaire/portada_saint_nazaire.png",
    "portada:messines": "remotion still MessinesPortada ../produccion/08_messines/portada_messines.png",
    "portada:bremen": "remotion still BremenPortada ../produccion/06_cielo_bremen/portada_cielo_bremen.png",
    "portada:kiel": "remotion still KielPortada ../produccion/11_motin_kiel/portada_motin_kiel.png",
    "portada:kiska": "remotion still KiskaPortada ../produccion/05_isla_kiska/portada_isla_kiska.png",
    "sonido:kiska": "tsx scripts/cues.ts kiska && python -I scripts/sound_design.py 05_isla_kiska audio/audio_master_censurado.wav audio/audio_final_mix.wav",
    "mute:scapa": "tsx scripts/mute.ts 13_scapa_flow audio/audio_master_voz.wav audio/audio_master_censurado.wav",
